---
import '@fontsource-variable/inter';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { profile } from '../data/portfolio';
import { image, isGif } from '../lib/images';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** File name in /images used for og:image. */
  ogImage?: string;
}

const { title, description, ogImage = profile.photo } = Astro.props;

const ogMeta = await image(ogImage);
const ogSrc = isGif(ogImage) ? ogMeta.src : (await getImage({ src: ogMeta, width: 1200, format: 'jpeg' })).src;
const ogUrl = new URL(ogSrc, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const home = url('/');
const nav = [
  { label: 'Work', hash: 'work' },
  { label: 'Experience', hash: 'experience' },
  { label: 'Skills', hash: 'skills' },
  { label: 'About', hash: 'about' },
  { label: 'Contact', hash: 'contact' },
].map((item) => ({ ...item, href: `${home}#${item.hash}` }));
const resumeHref = url(`/${profile.resume}`);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b0f" />
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#f5a524"/><text x="16" y="22" font-family="Arial,sans-serif" font-size="16" font-weight="700" text-anchor="middle" fill="#16110a">AB</text></svg>')}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Hide reveal targets before first paint; fx.ts reveals them. Fail open if it never runs.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const r = document.documentElement;
        r.classList.add('fx');
        setTimeout(() => r.classList.contains('fx-ready') || r.classList.remove('fx'), 2500);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={home}>{profile.name}</a>
        <nav class="nav-desktop" aria-label="Main">
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
          <a class="btn btn-primary btn-sm" href={resumeHref} download>Résumé</a>
        </nav>
        <details class="nav-mobile">
          <summary aria-label="Menu">
            <span class="burger" aria-hidden="true"></span>
          </summary>
          <nav aria-label="Main (mobile)">
            <ul>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
            <a class="btn btn-primary" href={resumeHref} download>Résumé (PDF)</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <ul class="footer-links">
          <li><a href={`mailto:${profile.email}`}>Email</a></li>
          {profile.links.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}
          <li><a href={resumeHref} download>Résumé</a></li>
        </ul>
        <p class="muted">© {year} {profile.name}</p>
      </div>
    </footer>

    <script>
      import '../scripts/fx';
    </script>
    <script>
      // Close the mobile menu after choosing a link (same-page anchors don't reload).
      const menu = document.querySelector<HTMLDetailsElement>('.nav-mobile');
      menu?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) menu.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(11 11 15 / 0.55);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid transparent;
    view-transition-name: site-header;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .site-header.is-scrolled {
    background: rgb(11 11 15 / 0.82);
    border-bottom-color: var(--border);
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.8);
  }

  /* Reading progress, driven by scroll position with no JS. */
  @supports (animation-timeline: scroll()) {
    .site-header::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 2px;
      background: linear-gradient(90deg, var(--accent), #ff7a3d);
      transform-origin: 0 50%;
      animation: read-progress linear both;
      animation-duration: auto;
      animation-timeline: scroll(root);
    }

    @keyframes read-progress {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }

  .brand {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .brand::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.55rem;
    vertical-align: 0.12em;
    background: var(--accent);
    box-shadow: 0 0 10px rgb(245 165 36 / 0.8);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .brand:hover::before {
    transform: rotate(135deg);
  }

  .brand:hover {
    color: var(--accent);
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }

  nav a:not(.btn) {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  nav a:not(.btn):hover {
    color: var(--text);
  }

  .nav-desktop li a {
    position: relative;
  }

  .nav-desktop li a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nav-desktop li a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-desktop ul {
    gap: 1.5rem;
  }

  .btn-sm {
    min-height: 38px;
    padding: 0.45rem 1rem;
    font-size: 0.9rem;
  }

  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    position: relative;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .burger::before {
    top: -6px;
  }

  .burger::after {
    top: 6px;
  }

  .nav-mobile[open] .burger {
    background: transparent;
  }

  .nav-mobile[open] .burger::before {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-mobile[open] .burger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav-mobile[open] nav {
    animation: menu-in 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      translate: 0 -8px;
    }
  }

  .nav-mobile nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem var(--gutter) 1.25rem;
  }

  .nav-mobile ul {
    flex-direction: column;
    margin-bottom: 1rem;
  }

  .nav-mobile li a {
    display: block;
    padding: 0.75rem 0;
    font-size: 1.05rem;
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 860px) {
    .nav-desktop {
      display: flex;
    }

    .nav-mobile {
      display: none;
    }
  }

  .site-footer {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--border);
    padding-block: 2rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .site-footer p {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
