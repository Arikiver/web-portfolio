---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroShader from '../components/HeroShader.astro';
import FeatureRow from '../components/FeatureRow.astro';
import WorkIndex from '../components/WorkIndex.astro';
import { disciplines, education, experience, otherWork, profile, projects, skills } from '../data/portfolio';
import { image } from '../lib/images';
import { url } from '../lib/url';

const featured = projects.filter((p) => p.featured);
const more = projects.filter((p) => !p.featured);
const bySlug = new Map(projects.map((p) => [p.slug, p]));
const projectLinks = (slugs: string[]) =>
  slugs.map((slug) => {
    const p = bySlug.get(slug);
    if (!p) throw new Error(`Unknown project slug: ${slug}`);
    return { href: url(`/work/${slug}/`), title: p.title };
  });
const resumeHref = url(`/${profile.resume}`);
const portrait = await image(profile.photo);
const otherImages = new Map(
  await Promise.all(otherWork.flatMap((w) => (w.image ? [image(w.image).then((m) => [w.image, m] as const)] : []))),
);
---

<Base title={`${profile.name} — ${profile.title}`} description={`${profile.fact} ${profile.intro}`}>
  <section class="hero" aria-labelledby="hero-title">
    <HeroShader />
    <div class="wrap hero-grid grid">
      <div class="hero-copy">
        <p class="label hero-label" data-hero>{profile.name} · {profile.location}</p>
        <h1 id="hero-title" class="hero-title" data-hero="lines">{profile.headline}</h1>
        <p class="lead hero-fact" data-hero>{profile.fact}</p>
        <p class="hero-intro" data-hero>{profile.intro}</p>
        <div class="btn-row" data-hero>
          <a class="btn btn-primary" href="#work">See selected work</a>
          <a class="btn" href={resumeHref} download>Download résumé</a>
        </div>
      </div>
      <figure class="hero-photo frame" data-hero="media">
        <Image
          src={portrait}
          alt={`Portrait of ${profile.name}`}
          widths={[320, 480, 720, 960]}
          sizes="(min-width: 1360px) 380px, (min-width: 900px) 28vw, 60vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <span class="glint" aria-hidden="true"></span>
      </figure>
    </div>
    <dl class="wrap hero-specs" data-hero>
      <div>
        <dt class="label">Disciplines</dt>
        <dd>Development, technical art, game design</dd>
      </div>
      <div>
        <dt class="label">Engines and code</dt>
        <dd>{profile.focus.slice(0, 3).join(' · ')}</dd>
      </div>
      <div>
        <dt class="label">Based in</dt>
        <dd>{profile.location}</dd>
      </div>
    </dl>
  </section>

  <section id="disciplines" class="section">
    <div class="wrap">
      <header class="section-head grid">
        <p class="label" data-reveal><span class="num">01</span>Disciplines</p>
        <h2 data-reveal="lines">Development, technical art and game design</h2>
      </header>
      <div class="disciplines">
        {
          disciplines.map((d) => (
            <article class="discipline" data-reveal-row>
              <h3 data-reveal="lines">{d.title}</h3>
              <p class="muted" data-reveal>{d.text}</p>
              <ul class="facts" data-reveal>
                {d.facts.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <p class="seen-in" data-reveal>
                <span class="label">Seen in</span>
                {projectLinks(d.links).map((l) => (
                  <a class="link" href={l.href}>
                    {l.title}
                  </a>
                ))}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="work" class="section">
    <div class="wrap">
      <header class="section-head grid">
        <p class="label" data-reveal><span class="num">02</span>Selected work</p>
        <h2 data-reveal="lines">Games and real-time projects</h2>
      </header>
      <div class="features">
        {featured.map((p, i) => <FeatureRow project={p} index={i + 1} />)}
      </div>
      <div class="more">
        <p class="label more-label" data-reveal>More projects</p>
        <WorkIndex projects={more} start={featured.length + 1} />
      </div>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="wrap">
      <header class="section-head grid">
        <p class="label" data-reveal><span class="num">03</span>Experience</p>
        <h2 data-reveal="lines">Studios, teams and clients</h2>
      </header>
      <ol class="xp">
        {
          experience.map((job) => (
            <li class="xp-row grid" data-reveal-row>
              <p class="xp-dates" data-reveal>
                <span class="pip" aria-hidden="true" />
                {job.dates}
              </p>
              <div class="xp-main">
                <h3 data-reveal="lines">{job.role}</h3>
                <p class="label xp-org" data-reveal>
                  {job.org} · {job.mode}
                </p>
                <p class="xp-summary measure" data-reveal>
                  {job.summary}
                </p>
                <p class="seen-in" data-reveal>
                  {projectLinks(job.projects).map((l) => (
                    <a class="link link-arrow" href={l.href}>
                      {l.title}
                    </a>
                  ))}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="skills" class="section">
    <div class="wrap">
      <header class="section-head grid">
        <p class="label" data-reveal><span class="num">04</span>Skills</p>
        <h2 data-reveal="lines">Languages, engines and tools</h2>
      </header>
      <dl class="skills">
        {
          skills.map((g) => (
            <div class="skill-row grid" data-reveal-row>
              <dt data-reveal>{g.group}</dt>
              <dd data-reveal>
                {g.items.map((item, i) => (
                  <>
                    {i > 0 && (
                      <span class="sep" aria-hidden="true">
                        /
                      </span>
                    )}
                    <span class="skill">{item}</span>
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="other-title">
    <div class="wrap">
      <header class="section-head grid">
        <p class="label" data-reveal><span class="num">05</span>Other work</p>
        <h2 id="other-title" data-reveal="lines">Rendering, tools and side projects</h2>
      </header>
      <ul class="others">
        {
          otherWork.map((w) => (
            <li class="other grid" data-reveal-row>
              <div class="other-main">
                <p class="label" data-reveal>
                  {w.kind}
                </p>
                <h3 data-reveal="lines">{w.title}</h3>
                <p class="muted measure" data-reveal>
                  {w.text}
                </p>
                {w.link && (
                  <a class="link link-arrow" href={w.link.url} rel="noopener" data-reveal>
                    {w.link.label}
                  </a>
                )}
              </div>
              {w.image && (
                <div class="other-media frame" data-reveal="media">
                  <Image
                    src={otherImages.get(w.image)!}
                    alt={`${w.title} render`}
                    widths={[400, 700, 1000]}
                    sizes="(min-width: 900px) 30vw, calc(100vw - 48px)"
                    format="webp"
                    loading="lazy"
                  />
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="about" class="section">
    <div class="wrap">
      <header class="section-head grid">
        <p class="label" data-reveal><span class="num">06</span>About</p>
        <h2 data-reveal="lines">How I work</h2>
      </header>
      <div class="about grid">
        <div class="about-text">
          {profile.about.map((para, i) => <p class:list={['measure', { lead: i === 0 }]} data-reveal>{para}</p>)}
        </div>
        <aside class="about-side" data-reveal>
          <p class="label">Education</p>
          <p class="edu-degree">{education.degree}</p>
          <p class="muted">
            {education.school} · {education.dates} · CGPA {education.cgpa}
          </p>
          <a class="btn" href={resumeHref} download>Download résumé</a>
        </aside>
      </div>
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="wrap">
      <header class="section-head grid">
        <p class="label" data-reveal><span class="num">07</span>Contact</p>
        <h2 data-reveal="lines">Write to me</h2>
      </header>
      <a class="contact-email link" href={`mailto:${profile.email}`} data-reveal>{profile.email}</a>
      <div class="contact-row" data-reveal>
        <ul class="contact-links">
          {
            profile.links.map((l) => (
              <li>
                <a class="link link-arrow" href={l.url} rel="noopener">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="label">{profile.location}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 48px;
    background: var(--ground);
  }

  /* Keep the text side of the fog calm enough to read. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(12 12 11 / 0.7), rgb(12 12 11 / 0.2) 60%, transparent);
  }

  .hero-grid,
  .hero-specs {
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    align-items: end;
    row-gap: 40px;
  }

  .hero-copy,
  .hero-photo {
    grid-column: 1 / -1;
  }

  .hero-label {
    margin-bottom: 24px;
  }

  .hero-title {
    font-size: clamp(2.9rem, 1.5rem + 4.6vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.022em;
    max-width: 15ch;
    margin-bottom: 32px;
  }

  .hero-fact {
    margin-bottom: 12px;
    max-width: 36em;
  }

  .hero-intro {
    color: var(--ink-2);
    max-width: 40em;
    margin-bottom: 32px;
  }

  .hero-photo {
    margin: 0;
    width: min(70%, 300px);
    aspect-ratio: 4 / 5;
    order: -1;
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s var(--ease);
  }

  .hero-photo:hover img {
    scale: 1.03;
  }

  /* A specular streak crosses the photo on hover (paired with the blade-gleam sound). */
  .glint {
    position: absolute;
    inset: -20%;
    background: linear-gradient(105deg, transparent 42%, rgb(255 244 222 / 0.22) 50%, transparent 58%);
    translate: -70% 0;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .hero-photo:hover .glint {
    translate: 70% 0;
    transition: translate 0.9s var(--ease-travel);
  }

  @media (min-width: 900px) {
    .hero {
      padding-top: 72px;
    }

    .hero-copy {
      grid-column: 1 / 9;
    }

    .hero-photo {
      order: 0;
      grid-column: 9 / 13;
      width: 100%;
      max-width: 380px;
      justify-self: end;
    }
  }

  .hero-specs {
    display: grid;
    gap: 16px 24px;
    margin-top: 56px;
    margin-bottom: 0;
    padding-block: 20px 56px;
    border-top: 1px solid var(--line);
  }

  .hero-specs dd {
    margin: 4px 0 0;
    font-size: var(--t-small);
  }

  @media (min-width: 720px) {
    .hero-specs {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ---------- Disciplines ---------- */
  .disciplines {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .disciplines {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .discipline {
      padding-inline: 24px;
      border-left: 1px solid var(--line);
    }

    .discipline:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }

  .discipline {
    display: flex;
    flex-direction: column;
  }

  .discipline h3 {
    font-size: var(--t-h3);
    margin-bottom: 16px;
  }

  .facts {
    list-style: none;
    margin: 8px 0 24px;
    padding: 0;
  }

  .facts li {
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: var(--t-small);
  }

  .seen-in {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    margin: auto 0 0;
    font-size: var(--t-small);
  }

  .seen-in .label {
    margin-right: 2px;
  }

  /* ---------- Work ---------- */
  .more {
    margin-top: 72px;
  }

  .more-label {
    margin-bottom: 16px;
  }

  /* ---------- Experience ---------- */
  .xp {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .xp-row {
    border-top: 1px solid var(--line);
    padding-block: 28px 36px;
    row-gap: 12px;
  }

  .xp-dates,
  .xp-main {
    grid-column: 1 / -1;
  }

  .xp-dates {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: var(--t-small);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* The pixel lights up as the row arrives (fx.ts adds .is-lit with the blip sound). */
  .pip {
    width: 7px;
    height: 7px;
    border: 1px solid var(--ink-3);
    flex: none;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .xp-row.is-lit .pip,
  html:not(.fx) .pip {
    background: var(--accent);
    border-color: var(--accent);
  }

  .xp-main h3 {
    font-size: var(--t-h4);
    margin-bottom: 6px;
  }

  .xp-org {
    margin-bottom: 14px;
  }

  .xp-summary {
    color: var(--ink-2);
    margin-bottom: 14px;
  }

  @media (min-width: 900px) {
    .xp-dates {
      grid-column: 1 / 4;
      align-self: start;
      padding-top: 0.45em;
    }

    .xp-main {
      grid-column: 4 / 12;
    }
  }

  /* ---------- Skills ---------- */
  .skills {
    margin: 0;
  }

  .skill-row {
    border-top: 1px solid var(--line);
    padding-block: 20px;
    row-gap: 8px;
  }

  .skill-row dt,
  .skill-row dd {
    grid-column: 1 / -1;
  }

  .skill-row dt {
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-2);
  }

  .skill-row dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    line-height: 1.7;
  }

  .sep {
    color: var(--ink-3);
    margin-inline: 0.55em;
  }

  .skill {
    white-space: nowrap;
  }

  @media (max-width: 559px) {
    .skill {
      white-space: normal;
    }
  }

  @media (min-width: 900px) {
    .skill-row dt {
      grid-column: 1 / 4;
    }

    .skill-row dd {
      grid-column: 4 / 13;
    }
  }

  /* ---------- Other work ---------- */
  .others {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .other {
    border-top: 1px solid var(--line);
    padding-block: 28px 36px;
    row-gap: 24px;
  }

  .other-main,
  .other-media {
    grid-column: 1 / -1;
  }

  .other h3 {
    font-size: var(--t-h4);
    margin: 8px 0 12px;
  }

  .other-media {
    aspect-ratio: 3 / 2;
  }

  .other-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s var(--ease);
  }

  .other-media:hover img {
    scale: 1.03;
  }

  @media (min-width: 900px) {
    .other-main {
      grid-column: 4 / 10;
    }

    .other-media {
      grid-column: 10 / 13;
    }
  }

  /* ---------- About ---------- */
  .about {
    row-gap: 48px;
  }

  .about-text,
  .about-side {
    grid-column: 1 / -1;
  }

  .about-text .lead {
    margin-bottom: 1.2em;
  }

  .about-text p:not(.lead) {
    color: var(--ink-2);
  }

  .about-side {
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .about-side .label {
    margin-bottom: 8px;
  }

  .edu-degree {
    font-family: var(--font-display);
    font-size: var(--t-h4);
    line-height: 1.15;
    margin-bottom: 8px;
  }

  .about-side .btn {
    margin-top: 16px;
  }

  @media (min-width: 900px) {
    .about-text {
      grid-column: 4 / 10;
    }

    .about-side {
      grid-column: 10 / 13;
    }
  }

  /* ---------- Contact ---------- */
  .contact-email {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1rem + 4.6vw, 5.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    background-size: 100% 1px;
    margin-bottom: 40px;
  }

  .contact-email:hover {
    color: var(--accent);
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px 32px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .contact-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }
</style>
