---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroShader from '../components/HeroShader.astro';
import FeaturedRing from '../components/FeaturedRing.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { disciplines, education, experience, otherWork, profile, projects, skills } from '../data/portfolio';
import { image } from '../lib/images';
import { url } from '../lib/url';

const featured = projects.filter((p) => p.featured);
const bySlug = new Map(projects.map((p) => [p.slug, p]));
const projectLinks = (slugs: string[]) =>
  slugs.map((slug) => {
    const p = bySlug.get(slug);
    if (!p) throw new Error(`Unknown project slug: ${slug}`);
    return { href: url(`/work/${slug}/`), title: p.title };
  });
const resumeHref = url(`/${profile.resume}`);
const portrait = await image(profile.photo);
const otherImages = new Map(
  await Promise.all(otherWork.flatMap((w) => (w.image ? [image(w.image).then((m) => [w.image, m] as const)] : []))),
);
const [first, last] = profile.name.split(' ');
const roles = ['Game developer', 'Technical artist', 'Game designer'];
const band = ['Unity', 'Roblox', 'HLSL', 'Luau', 'C#', 'Shader Graph', 'Blender', 'Netcode', 'URP', 'Aseprite', 'WebGL', 'GameMaker'];
---

<Base title={`${profile.name} — ${profile.title}`} description={`${profile.fact} ${profile.intro}`}>
  <section class="hero" aria-labelledby="hero-title">
    <HeroShader />
    <div class="wrap hero-grid">
      <p class="hud hero-top" data-hero><span class="num">P1</span>{profile.location} · Portfolio {new Date().getFullYear()}</p>

      <h1 id="hero-title" class="hero-name">
        <span class="hn-1"><span data-hero="chars">{first}</span></span>
        <span class="hn-2"><span data-hero="chars">{last}</span></span>
      </h1>

      <div class="hero-photo">
        <div class="hero-card corners" data-hero="pop" data-tilt="12">
          <Image
            src={portrait}
            alt={`Portrait of ${profile.name}`}
            widths={[320, 480, 720, 960]}
            sizes="(min-width: 900px) 360px, 48vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
          <span class="glint" aria-hidden="true"></span>
          <span class="glare" aria-hidden="true"></span>
          <span class="hud card-tag" aria-hidden="true"><i></i>Player 1</span>
        </div>
      </div>

      <div class="hero-copy">
        <p class="hero-role" data-hero>
          <span class="sr-only">{roles.join(', ')}</span>
          <span class="prism" aria-hidden="true">
            <span class="prism-size">Technical artist</span>
            <span class="prism-in">
              {roles.map((r) => <span class="face">{r}</span>)}
            </span>
          </span>
        </p>
        <p class="lead hero-fact" data-hero>{profile.fact}</p>
        <p class="hero-intro" data-hero>{profile.intro}</p>
        <div class="btn-row" data-hero>
          <a class="btn btn-primary" href="#work" data-magnetic>See the work</a>
          <a class="btn" href={resumeHref} download data-magnetic>Download résumé</a>
        </div>
      </div>
    </div>
    <dl class="wrap hero-specs" data-hero>
      <div><dt class="hud">Disciplines</dt><dd>Development · Technical art · Design</dd></div>
      <div><dt class="hud">Engines</dt><dd>Unity · Roblox · GameMaker</dd></div>
      <div><dt class="hud">Shipping</dt><dd>Mobile · WebGL · AR · Roblox</dd></div>
      <div class="scroll-cue"><dt class="hud">Scroll</dt><dd><span class="cue-bar"><i></i></span></dd></div>
    </dl>
  </section>

  <FeaturedRing projects={featured} />

  <ProjectGrid projects={projects} />

  <div class="band" aria-hidden="true">
    <div class="band-row"><div class="band-track">{[...band, ...band].map((b) => <span>{b}<i>✦</i></span>)}</div></div>
    <div class="band-row band-rev"><div class="band-track">{[...band, ...band].reverse().map((b) => <span>{b}<i>✦</i></span>)}</div></div>
  </div>

  <section id="disciplines" class="section">
    <div class="wrap">
      <header class="sec-head" data-reveal-group>
        <p class="hud" data-reveal><span class="num">03</span>Disciplines</p>
        <h2 data-reveal="lines">Three disciplines</h2>
        <p class="intro" data-reveal>I write the systems, build the shaders and design the numbers, usually on the same project.</p>
      </header>
      <div class="disc-grid">
        {
          disciplines.map((d, i) => (
            <article class="discipline corners" data-reveal-group data-tilt="4">
              <span class="glare" aria-hidden="true" />
              <p class="disc-idx" aria-hidden="true">{`0${i + 1}`}</p>
              <h3 data-reveal="lines">{d.title}</h3>
              <p class="muted disc-text" data-reveal>{d.text}</p>
              <ul class="stats">
                {d.stats.map((s) => (
                  <li class="stat" data-reveal>
                    <span class="stat-v" data-reveal="count">{s.value}</span>
                    <span class="stat-l">{s.label}</span>
                  </li>
                ))}
              </ul>
              <p class="seen-in" data-reveal>
                <span class="hud">Seen in</span>
                {projectLinks(d.links).map((l) => (
                  <a class="link" href={l.href}>{l.title}</a>
                ))}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="wrap">
      <header class="sec-head" data-reveal-group>
        <p class="hud" data-reveal><span class="num">04</span>Experience</p>
        <h2 data-reveal="lines">Studios and clients</h2>
      </header>
      <div class="xp">
        <div class="xp-line" aria-hidden="true"><i class="xp-fill"></i></div>
        <ol class="xp-list">
          {
            experience.map((job) => (
              <li class="xp-row" data-reveal-group>
                <span class="xp-pip" aria-hidden="true" />
                <p class="hud xp-dates" data-reveal>{job.dates}</p>
                <div class="xp-card corners" data-reveal="pop">
                  <h3>{job.role}</h3>
                  <p class="hud xp-org">{job.org} · {job.mode}</p>
                  <p class="xp-summary">{job.summary}</p>
                  <p class="seen-in">
                    {projectLinks(job.projects).map((l) => (
                      <a class="link link-arrow" href={l.href}>{l.title}</a>
                    ))}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section id="skills" class="section">
    <div class="wrap">
      <header class="sec-head" data-reveal-group>
        <p class="hud" data-reveal><span class="num">05</span>Skills</p>
        <h2 data-reveal="lines">Loadout</h2>
      </header>
      <div class="skills">
        {
          skills.map((g) => (
            <div class="skill-row" data-reveal-group>
              <h3 class="hud" data-reveal>{g.group}</h3>
              <ul class="chips" data-reveal>
                {g.items.map((item) => (
                  <li class="chip">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="other-title">
    <div class="wrap">
      <header class="sec-head" data-reveal-group>
        <p class="hud" data-reveal><span class="num">06</span>Other work</p>
        <h2 id="other-title" data-reveal="lines">Side quests</h2>
      </header>
      <ul class="others">
        {
          otherWork.map((w) => (
            <li class="other corners" data-reveal-group>
              {w.image && (
                <div class="other-media frame" data-reveal="media">
                  <Image
                    src={otherImages.get(w.image)!}
                    alt={`${w.title} render`}
                    widths={[400, 700, 1000]}
                    sizes="(min-width: 900px) 30vw, 100vw"
                    format="webp"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="other-body">
                <p class="hud" data-reveal>{w.kind}</p>
                <h3 data-reveal="lines">{w.title}</h3>
                <p class="muted" data-reveal>{w.text}</p>
                {w.link && (
                  <a class="link link-arrow" href={w.link.url} rel="noopener" data-reveal>
                    {w.link.label}
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="about" class="section">
    <div class="wrap">
      <header class="sec-head" data-reveal-group>
        <p class="hud" data-reveal><span class="num">07</span>About</p>
        <h2 data-reveal="lines">How I work</h2>
      </header>
      <div class="about">
        <div class="about-text" data-reveal-group>
          {profile.about.map((para, i) => <p class:list={['measure', { lead: i === 0, muted: i > 0 }]} data-reveal>{para}</p>)}
        </div>
        <aside class="about-side corners" data-reveal="pop">
          <p class="hud">Education</p>
          <p class="edu-degree">{education.degree}</p>
          <p class="muted">{education.school} · {education.dates} · CGPA {education.cgpa}</p>
          <a class="btn" href={resumeHref} download>Download résumé</a>
        </aside>
      </div>
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="wrap">
      <p class="hud" data-reveal><span class="num">08</span>Contact · {profile.location}</p>
      <h2 class="contact-title" data-reveal="lines">Get in touch</h2>
      <a class="contact-email" href={`mailto:${profile.email}`} data-cursor="Write" data-reveal>{profile.email}</a>
      <div class="btn-row contact-links" data-reveal>
        {profile.links.map((l) => <a class="btn" href={l.url} rel="noopener" data-magnetic>{l.label}</a>)}
        <a class="btn btn-primary" href={resumeHref} download data-magnetic>Download résumé</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';
  import { motionOK, scene } from '../scripts/scene';

  gsap.registerPlugin(ScrollTrigger, SplitText);
  const motion = motionOK();

  // Role prism: three faces of a triangular prism, turning every few seconds.
  const prism = document.querySelector<HTMLElement>('.prism-in');
  if (prism && motion) {
    const faces = [...prism.querySelectorAll<HTMLElement>('.face')];
    const depth = () => prism.offsetHeight * 0.2887;
    const place = () => faces.forEach((f, i) => (f.style.transform = `rotateX(${i * -120}deg) translateZ(${depth()}px)`));
    place();
    addEventListener('resize', place);
    const tl = gsap.timeline({ repeat: -1, paused: true });
    for (let i = 1; i <= faces.length; i++) tl.to(prism, { rotationX: i * 120, duration: 0.9, ease: 'expo.inOut' }, i * 2.6);
    const start = () => tl.play();
    if (document.documentElement.classList.contains('booting')) document.addEventListener('boot:done', start, { once: true });
    else setTimeout(start, 900);
    // Pause when the hero is off screen.
    new IntersectionObserver(([e]) => (e.isIntersecting ? tl.play() : tl.pause())).observe(prism);
  } else if (prism) {
    prism.querySelectorAll<HTMLElement>('.face').forEach((f, i) => i > 0 && (f.hidden = true));
  }

  // Marquee band: drifts on its own, speeds up and skews with scroll velocity.
  const tracks = [...document.querySelectorAll<HTMLElement>('.band-track')];
  if (tracks.length && motion) {
    const loops = tracks.map((t, i) =>
      i === 0
        ? gsap.to(t, { xPercent: -50, duration: 40, ease: 'none', repeat: -1 })
        : gsap.fromTo(t, { xPercent: -50 }, { xPercent: 0, duration: 46, ease: 'none', repeat: -1 }),
    );
    const skew = gsap.quickTo('.band', 'skewY', { duration: 0.6, ease: 'power3.out' });
    scene(() => {
      ScrollTrigger.create({
        trigger: '.band',
        start: 'top bottom',
        end: 'bottom top',
        onUpdate: (self) => {
          const v = self.getVelocity();
          loops.forEach((l) => gsap.to(l, { timeScale: 1 + Math.min(Math.abs(v) / 250, 8), duration: 0.2, overwrite: true }));
          skew(Math.max(-4, Math.min(4, v / -400)));
        },
        onLeave: () => skew(0),
        onLeaveBack: () => skew(0),
      });
    });
    setInterval(() => loops.forEach((l) => l.timeScale() > 1.05 && gsap.to(l, { timeScale: 1, duration: 1.2 })), 400);
  }

  // Experience: the line draws with scroll and lights each pip as it passes.
  scene(() => {
    if (!motion) return;
    const list = document.querySelector<HTMLElement>('.xp-list');
    const pips = [...document.querySelectorAll<HTMLElement>('.xp-pip')];
    if (!list) return;
    gsap.fromTo(
      '.xp-fill',
      { scaleY: 0 },
      {
        scaleY: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: list,
          start: 'top 65%',
          end: 'bottom 65%',
          scrub: 0.4,
          onUpdate: (self) => {
            const y = self.progress * list.offsetHeight;
            pips.forEach((p) => p.classList.toggle('is-lit', p.offsetTop <= y + 4));
          },
        },
      },
    );
  });

  // Contact email: the letters ripple on hover.
  const email = document.querySelector<HTMLElement>('.contact-email');
  if (email && motion) {
    const split = SplitText.create(email, { type: 'chars', charsClass: 'ec' });
    email.addEventListener('pointerenter', () =>
      gsap.fromTo(split.chars, { yPercent: 0 }, { yPercent: -18, duration: 0.25, ease: 'power2.out', stagger: 0.015, yoyo: true, repeat: 1, overwrite: true }),
    );
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 32px;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(8 8 10 / 0.75), rgb(8 8 10 / 0.1) 65%, transparent),
      linear-gradient(to top, var(--ground), transparent 30%);
  }

  .hero-grid,
  .hero-specs {
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 20px;
    row-gap: 24px;
    align-items: end;
  }

  .hero-top,
  .hero-name,
  .hero-copy {
    grid-column: 1 / -1;
  }

  .hero-name {
    font-size: var(--t-mega);
    font-weight: 900;
    font-stretch: 64%;
    line-height: 0.84;
    letter-spacing: -0.015em;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 899px) {
    .hero-name {
      font-size: min(21vw, 9rem);
    }
  }

  .hn-1,
  .hn-2 {
    display: block;
    will-change: transform;
  }

  .hn-2 {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    padding-left: 0.6em;
  }

  .hero-photo {
    grid-column: 7 / -1;
    grid-row: 1 / span 2;
    justify-self: end;
    width: min(48vw, 220px);
  }

  .hero-card {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.9);
  }

  .hero-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.8s var(--ease);
  }

  .hero-card:hover img {
    scale: 1.04;
  }

  .glint {
    position: absolute;
    inset: -20%;
    z-index: 2;
    background: linear-gradient(105deg, transparent 42%, rgb(255 244 222 / 0.3) 50%, transparent 58%);
    translate: -70% 0;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .hero-card:hover .glint {
    translate: 70% 0;
    transition: translate 0.9s var(--ease-travel);
  }

  .card-tag {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 9px;
    background: rgb(8 8 10 / 0.7);
    color: var(--ink);
    font-size: 0.625rem;
  }

  .card-tag i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .hero-role {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 72%;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 1rem + 2.6vw, 3.2rem);
    line-height: 1;
    color: var(--accent);
  }

  .prism {
    position: relative;
    display: inline-block;
    perspective: 700px;
    vertical-align: top;
  }

  .prism-size {
    visibility: hidden;
    display: block;
    height: 1.05em;
  }

  .prism-in {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .face {
    position: absolute;
    inset: 0;
    white-space: nowrap;
    backface-visibility: hidden;
  }

  .hero-fact {
    max-width: 34em;
    margin-bottom: 10px;
  }

  .hero-intro {
    color: var(--ink-2);
    max-width: 42em;
    margin-bottom: 28px;
  }

  .hero-specs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 24px;
    margin: 40px auto 0;
    padding-block: 18px 32px;
    border-top: 1px solid var(--line);
  }

  .hero-specs dd {
    margin: 6px 0 0;
    font-size: var(--t-small);
  }

  .scroll-cue {
    display: none;
  }

  .cue-bar {
    display: block;
    width: 64px;
    height: 2px;
    margin-top: 12px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .cue-bar i {
    display: block;
    width: 40%;
    height: 100%;
    background: var(--accent);
    animation: cue 1.8s var(--ease-travel) infinite;
  }

  @keyframes cue {
    from {
      translate: -100% 0;
    }
    to {
      translate: 260% 0;
    }
  }

  @media (min-width: 900px) {
    .hero-name {
      grid-column: 1 / 10;
      grid-row: 2;
    }

    .hero-photo {
      grid-column: 9 / -1;
      grid-row: 2 / span 2;
      width: 100%;
      max-width: 360px;
      align-self: center;
    }

    .hero-copy {
      grid-column: 1 / 9;
      grid-row: 3;
    }

    .hero-specs {
      grid-template-columns: repeat(4, 1fr);
    }

    .scroll-cue {
      display: block;
      justify-self: end;
      text-align: right;
    }

    .cue-bar {
      margin-left: auto;
    }
  }

  /* ---------- Marquee band ---------- */
  .band {
    margin-top: var(--sec);
    padding-block: 18px;
    border-block: 1px solid var(--line);
    overflow: hidden;
    background: var(--ground-alt);
  }

  .band-row {
    overflow: hidden;
    white-space: nowrap;
  }

  .band-track {
    display: inline-flex;
    will-change: transform;
  }

  .band-track span {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding-right: 0.5em;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 62%;
    text-transform: uppercase;
    font-size: clamp(3rem, 1.5rem + 5vw, 7rem);
    line-height: 1;
  }

  .band-track i {
    font-style: normal;
    color: var(--accent);
    font-size: 0.4em;
  }

  .band-rev span {
    color: transparent;
    -webkit-text-stroke: 1px var(--ink-3);
  }

  /* ---------- Disciplines ---------- */
  .disc-grid {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 1000px) {
    .disc-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .discipline {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px 26px 26px;
    background: linear-gradient(180deg, var(--ground-alt), var(--ground));
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .discipline:hover {
    border-color: rgb(245 165 36 / 0.35);
  }

  .disc-idx {
    position: absolute;
    right: 14px;
    top: -14px;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 62%;
    font-size: 9rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgb(240 237 231 / 0.09);
    pointer-events: none;
  }

  .discipline h3 {
    font-size: var(--t-h3);
    margin-bottom: 16px;
    max-width: 8ch;
  }

  .disc-text {
    font-size: var(--t-small);
    margin-bottom: 24px;
  }

  .stats {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 16px;
    row-gap: 2px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
  }

  .stat {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }

  .stat-v {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 70%;
    font-size: 2.1rem;
    line-height: 1;
    color: var(--accent);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .stat-l {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.4;
  }

  .seen-in {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    margin: auto 0 0;
    font-size: var(--t-small);
  }

  /* ---------- Experience ---------- */
  .xp {
    position: relative;
  }

  .xp-line {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 5px;
    width: 1px;
    background: var(--line-strong);
  }

  .xp-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform-origin: 50% 0;
    box-shadow: 0 0 10px var(--accent);
