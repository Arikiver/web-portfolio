---
import Base from '../layouts/Base.astro';
import { profile } from '../data/portfolio';
import { url } from '../lib/url';
---

<Base title={`Page not found — ${profile.name}`} description="This page doesn't exist.">
  <section class="container not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="muted">This page doesn't exist or has moved.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={url('/')}>Back home</a>
      <a class="btn" href={`${url('/')}#work`}>View work</a>
    </div>
  </section>
</Base>

<style>
  .not-found {
    padding-top: clamp(4rem, 12vw, 8rem);
    min-height: 50vh;
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4rem);
  }

  .btn-row {
    margin-top: 2rem;
  }
</style>
