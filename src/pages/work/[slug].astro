---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Gallery from '../../components/Gallery.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { disciplineLabel, profile, projects, type Project } from '../../data/portfolio';
import { isGenerated } from '../../lib/images';
import { url } from '../../lib/url';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;
const index = projects.indexOf(project) + 1;
const disciplines = project.disciplines.map((d) => disciplineLabel[d]).join(' · ');
// Typeset covers have no raster image to share, so previews fall back to the portrait.
const ogImage = isGenerated(project.cover) ? profile.photo : project.cover;
---

<Base title={`${project.title} — ${profile.name}`} description={project.pitch} ogImage={ogImage}>
  <article class="project">
    <div class="wrap">
      <a class="back link" href={`${url('/')}#work`}>← All work</a>

      <header class="p-head grid">
        <div class="p-head-text">
          <p class="label" data-hero>
            <span class="num">{String(index).padStart(2, '0')}</span>{disciplines}
          </p>
          <h1 data-hero="lines" style={`view-transition-name: title-${project.slug}`}>{project.title}</h1>
          <p class="lead" data-hero>{project.pitch}</p>
          {project.status && <p class="status label" data-hero><span class="status-pip" aria-hidden="true" />{project.status}</p>}
        </div>
        <div class="p-cover frame" data-hero="media">
          <Cover
            file={project.cover}
            alt={`${project.title} cover art`}
            sizes="(min-width: 900px) 420px, calc(100vw - 48px)"
            widths={[400, 640, 900]}
            vt={`cover-${project.slug}`}
            eager
          />
        </div>
      </header>

      <dl class="p-meta" data-hero>
        {
          project.meta.map((m) => (
            <div>
              <dt class="label">{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    {
      project.video && (
        <div class="wrap p-video" data-reveal="media">
          <VideoEmbed video={project.video} poster={project.cover} />
        </div>
      )
    }

    <div class="wrap p-body">
      <section class="p-row grid" data-reveal-row>
        <h2 data-reveal="lines">Overview</h2>
        <div class="p-content">
          {project.overview.map((para, i) => <p class:list={['measure', { lead: i === 0 }]} data-reveal>{para}</p>)}
        </div>
      </section>

      {
        project.role && (
          <section class="p-row grid" data-reveal-row>
            <h2 data-reveal="lines">My role</h2>
            <div class="p-content">
              <p class="measure" data-reveal>
                {project.role}
              </p>
            </div>
          </section>
        )
      }

      {
        project.sections.map((sec) => (
          <section class="p-row grid" data-reveal-row>
            <h2 data-reveal="lines">{sec.heading}</h2>
            <ol class="p-content points">
              {sec.points.map((pt) => (
                <li class="measure" data-reveal>
                  {pt}
                </li>
              ))}
            </ol>
          </section>
        ))
      }

      <section class="p-row grid" data-reveal-row>
        <h2 data-reveal="lines">Stack</h2>
        <p class="p-content stack" data-reveal>
          {project.stack.map((t, i) => (
            <>
              {i > 0 && (
                <span class="sep" aria-hidden="true">
                  /
                </span>
              )}
              <span>{t}</span>
            </>
          ))}
        </p>
      </section>

      {
        (project.links.length > 0 || project.note) && (
          <section class="p-row grid" data-reveal-row>
            <h2 data-reveal="lines">Links</h2>
            <div class="p-content">
              {project.links.length > 0 && (
                <div class="btn-row" data-reveal>
                  {project.links.map((l, i) => (
                    <a class:list={['btn', { 'btn-primary': i === 0 }]} href={l.url} rel="noopener">
                      {l.label}
                    </a>
                  ))}
                </div>
              )}
              {project.note && (
                <p class="note label" role="note" data-reveal>
                  {project.note}
                </p>
              )}
            </div>
          </section>
        )
      }
    </div>

    {
      project.gallery && project.gallery.length > 0 && (
        <section class="wrap p-gallery" aria-labelledby="shots">
          <header class="p-row grid p-gallery-head" data-reveal-row>
            <h2 id="shots" data-reveal="lines">
              Screenshots
            </h2>
          </header>
          <Gallery items={project.gallery} />
        </section>
      )
    }

    <nav class="wrap pager" aria-label="More projects">
      <a class="pager-link" href={url(`/work/${prev.slug}/`)}>
        <span class="label">← Previous project</span>
        <span class="pager-title">{prev.title}</span>
      </a>
      <a class="pager-link next" href={url(`/work/${next.slug}/`)}>
        <span class="label">Next project →</span>
        <span class="pager-title">{next.title}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .project {
    padding-top: 32px;
  }

  .back {
    display: inline-block;
    margin-bottom: 40px;
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .back:hover {
    color: var(--ink);
  }

  .p-head {
    row-gap: 32px;
    align-items: end;
  }

  .p-head-text,
  .p-cover {
    grid-column: 1 / -1;
  }

  .p-head h1 {
    font-size: var(--t-hero);
    line-height: 0.98;
    letter-spacing: -0.022em;
    margin: 20px 0 24px;
    max-width: 12ch;
  }

  .p-head .lead {
    color: var(--ink-2);
    margin-bottom: 20px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }

  .status-pip {
    width: 7px;
    height: 7px;
    background: var(--accent);
  }

  .p-cover {
    width: min(100%, 420px);
    aspect-ratio: 1;
  }

  .p-cover :global(.cover) {
    height: 100%;
  }

  @media (min-width: 900px) {
    .p-head-text {
      grid-column: 1 / 8;
    }

    .p-cover {
      grid-column: 9 / 13;
      justify-self: end;
    }
  }

  .p-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 20px 24px;
    margin: 48px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .p-meta dd {
    margin: 4px 0 0;
    font-size: var(--t-small);
    font-variant-numeric: tabular-nums;
  }

  .p-video {
    margin-top: 72px;
  }

  .p-body {
    margin-top: 72px;
  }

  /* Document rows: heading on the left, content on the grid. */
  .p-row {
    border-top: 1px solid var(--line);
    padding-block: 28px 40px;
    row-gap: 16px;
  }

  .p-row h2 {
    grid-column: 1 / -1;
    font-size: var(--t-h4);
    line-height: 1.15;
  }

  .p-content {
    grid-column: 1 / -1;
    margin: 0;
  }

  .p-content p:not(.lead) {
    color: var(--ink-2);
  }

  @media (min-width: 900px) {
    .p-row h2 {
      grid-column: 1 / 4;
    }

    .p-content {
      grid-column: 4 / 12;
    }
  }

  .points {
    list-style: none;
    padding: 0;
    counter-reset: point;
  }

  .points li {
    counter-increment: point;
    position: relative;
    padding-left: 2.5em;
    color: var(--ink-2);
  }

  .points li + li {
    margin-top: 14px;
  }

  .points li::before {
    content: counter(point, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.2em;
    font-size: var(--t-label);
    font-weight: 500;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    line-height: 1.8;
  }

  .sep {
    color: var(--ink-3);
    margin-inline: 0.55em;
  }

  .note {
    margin-top: 16px;
  }

  .p-gallery {
    margin-top: 72px;
  }

  .p-gallery-head {
    padding-bottom: 24px;
  }

  .pager {
    display: grid;
    margin-top: 96px;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 720px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 0 8px;
    color: var(--ink);
    text-decoration: none;
  }

  .pager-link.next {
    text-align: right;
    align-items: flex-end;
  }

  @media (max-width: 719px) {
    .pager-link.next {
      border-top: 1px solid var(--line);
    }
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: 1.05;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0% 1px;
    transition: background-size var(--hover-out) var(--ease);
  }

  .pager-link.next .pager-title {
    background-position: 100% 100%;
  }

  .pager-link:hover .pager-title {
    background-size: 100% 1px;
    transition-duration: var(--hover-in);
  }
</style>
