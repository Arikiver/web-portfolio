---
import { Image } from 'astro:assets';
import { coverPresentation, image, isGif } from '../lib/images';

interface Props {
  file: string;
  alt: string;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  /** view-transition-name, so the art morphs between pages. */
  vt?: string;
}

const { file, alt, sizes, widths = [360, 560, 800, 1100], eager = false, class: className, vt } = Astro.props;
const src = await image(file);
const { fit, bg, radius } = coverPresentation(file);
const loading = eager ? 'eager' : 'lazy';
---

<div
  class:list={['cover', `cover-${fit}`, className]}
  style={[bg && `--cover-bg: ${bg}`, radius && `--logo-radius: ${radius}`, vt && `view-transition-name: ${vt}`].filter(Boolean).join('; ') || undefined}
>
  {
    isGif(file) ? (
      // Served untouched so the animation survives; scaled up with nearest-neighbour.
      <img class="pixelated" src={src.src} width={src.width} height={src.height} alt={alt} loading={loading} decoding="async" />
    ) : (
      <Image
        src={src}
        alt={alt}
        widths={widths.filter((w) => w <= src.width).concat(src.width < widths[0] ? [src.width] : [])}
        sizes={sizes}
        format="webp"
        loading={loading}
        fetchpriority={eager ? 'high' : undefined}
      />
    )
  }
</div>

<style>
  .cover {
    aspect-ratio: 1;
    background: var(--cover-bg, var(--surface-2));
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-contain {
    padding: 14%;
  }

  .cover-contain img {
    object-fit: contain;
    border-radius: var(--logo-radius, 0);
  }
</style>
