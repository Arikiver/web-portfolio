---
// Selected work. On desktop with motion: a pinned 3D ring of key art that scroll (or drag) turns,
// snapping project by project, with a live info panel. Everywhere else (phones, reduced motion, no
// JS): a swipe carousel with a light coverflow tilt. JS turns the ring on by adding html.ring-on.
import Cover from './Cover.astro';
import { disciplineLabel, type Project } from '../data/portfolio';
import { url } from '../lib/url';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const meta = (p: Project, ...labels: string[]) => labels.map((l) => p.meta.find((m) => m.label === l)?.value).find(Boolean);
const tags = (p: Project) => [meta(p, 'Dates', 'Released'), (meta(p, 'Engine') ?? p.stack[0])?.replace(/ \(.*\)$/, '')].filter(Boolean) as string[];
const discs = (p: Project) => p.disciplines.map((d) => disciplineLabel[d]).join(' · ');
---

<section id="work" class="ring-sec">
  <div class="ring-pin">
    <div class="ring-floor" aria-hidden="true"></div>
    <h2 class="ring-ghost">Selected work</h2>
    <div class="wrap ring-head">
      <p class="hud"><span class="num">01</span>Selected work · scroll or drag</p>
      <p class="hud ring-count" aria-hidden="true"><span class="ring-cur">01</span> / {pad(projects.length)}</p>
    </div>

    <div class="ring-scene" data-cursor="Drag">
      <div class="ring-tilt">
        <div class="ring">
          {
            projects.map((p, i) => (
              <a class="ring-card corners" href={url(`/work/${p.slug}/`)} data-i={i} data-cursor="Open" aria-label={`${p.title}: open project`}>
                <Cover file={p.cover} alt="" sizes="(min-width: 900px) 420px, 80vw" widths={[420, 840]} position={p.coverPosition} />
                <span class="ring-shade" aria-hidden="true" />
                <span class="ring-num hud" aria-hidden="true">
                  {pad(i + 1)}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="wrap ring-foot">
      <div class="ring-info" aria-live="polite">
        {
          projects.map((p, i) => (
            <div class:list={['ri', { 'is-active': i === 0 }]} data-i={i}>
              <p class="hud">{discs(p)}</p>
              <h3 class="ri-title">{p.title}</h3>
              <p class="ri-pitch">{p.pitch}</p>
              <ul class="ri-tags">
                {tags(p).map((t) => (
                  <li class="hud-tag">{t}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="ring-ctrl">
        <div class="ring-nav">
          <button type="button" class="btn btn-sm" data-step="-1" aria-label="Previous project">←</button>
          <button type="button" class="btn btn-sm" data-step="1" aria-label="Next project">→</button>
        </div>
        <a class="btn btn-primary ring-open" href={url(`/work/${projects[0].slug}/`)} data-magnetic>Open project</a>
      </div>
    </div>
    <div class="ring-progress" aria-hidden="true"><i></i></div>
  </div>

  <div class="rl">
    <div class="wrap rl-head">
      <p class="hud"><span class="num">01</span>Selected work</p>
      <h2>Selected work</h2>
    </div>
    <ul class="rl-track">
      {
        projects.map((p, i) => (
          <li class="rl-item">
            <a class="rl-card corners" href={url(`/work/${p.slug}/`)}>
              <div class="rl-media frame">
                <Cover file={p.cover} alt={`${p.title} cover art`} sizes="80vw" widths={[400, 800]} position={p.coverPosition} />
                <span class="ring-num hud" aria-hidden="true">
                  {pad(i + 1)}
                </span>
              </div>
              <div class="rl-body">
                <p class="hud">{discs(p)}</p>
                <h3>{p.title}</h3>
                <p class="ri-pitch">{p.pitch}</p>
                <ul class="ri-tags">
                  {tags(p).map((t) => (
                    <li class="hud-tag">{t}</li>
                  ))}
                </ul>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';
  import { SplitText } from 'gsap/SplitText';
  import { desktop, finePointer, motionOK, scene } from '../scripts/scene';
  import { play } from '../scripts/sfx';

  gsap.registerPlugin(ScrollTrigger, ScrollToPlugin, SplitText);

  const root = document.documentElement;
  const sec = document.querySelector<HTMLElement>('.ring-sec');

  if (sec) {
    const pin = sec.querySelector<HTMLElement>('.ring-pin')!;
    const ring = sec.querySelector<HTMLElement>('.ring')!;
    const tilt = sec.querySelector<HTMLElement>('.ring-tilt')!;
    const sceneEl = sec.querySelector<HTMLElement>('.ring-scene')!;
    const cards = [...sec.querySelectorAll<HTMLAnchorElement>('.ring-card')];
    const shades = cards.map((c) => c.querySelector<HTMLElement>('.ring-shade')!);
    const panels = [...sec.querySelectorAll<HTMLElement>('.ri')];
    const cur = sec.querySelector<HTMLElement>('.ring-cur')!;
    const open = sec.querySelector<HTMLAnchorElement>('.ring-open')!;
    const ghost = sec.querySelector<HTMLElement>('.ring-ghost')!;
    const floor = sec.querySelector<HTMLElement>('.ring-floor')!;
    const bar = sec.querySelector<HTMLElement>('.ring-progress i')!;
    const N = cards.length;
    // An arc, not a full ring: neighbours sit at a readable angle instead of edge-on.
    const STEP = Math.min(360 / N, 36);

    // Titles split once into masked characters for the panel swap.
    const titleChars = panels.map((p) => SplitText.create(p.querySelector('.ri-title')!, { type: 'chars', mask: 'chars' }).chars);

    scene((scroller) => {
      if (!motionOK() || !desktop() || N < 2) {
        root.classList.remove('ring-on');
        return;
      }
      root.classList.add('ring-on');

      const navH = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 64;
      const W = cards[0].offsetWidth;
      const R = Math.round((W * 1.12) / (2 * Math.sin((STEP * Math.PI) / 360)));
      const state = { a: 0 };
      let active = 0;

      const render = () => {
        ring.style.transform = `translateZ(${-R}px) rotateY(${state.a}deg)`;
        cards.forEach((c, i) => {
          let th = (i * STEP + state.a) % 360;
          if (th > 180) th -= 360;
          if (th < -180) th += 360;
          c.style.transform = `rotateY(${i * STEP}deg) translateZ(${R}px)`;
          const facing = Math.cos((th * Math.PI) / 180);
          shades[i].style.opacity = String(Math.min(0.9, Math.max(0, (1 - facing) * 2.4)));
          c.style.pointerEvents = facing > 0.5 ? '' : 'none';
          c.style.visibility = facing > 0.4 ? '' : 'hidden';
        });
        ghost.style.transform = `translate3d(${state.a * 4}px, 0, 0)`;
        floor.style.backgroundPosition = `${state.a * -6}px 0`;
        const p = -state.a / ((N - 1) * STEP);
        bar.style.transform = `scaleX(${Math.max(0, Math.min(1, p))})`;
        const next = Math.max(0, Math.min(N - 1, Math.round(-state.a / STEP)));
        if (next !== active) setActive(next);
      };

      const setActive = (i: number) => {
        const prev = active;
        active = i;
        cur.textContent = String(i + 1).padStart(2, '0');
        open.href = cards[i].href;
        cards.forEach((c, k) => c.classList.toggle('is-front', k === i));
        play('ringTick', i);
        const out = panels[prev];
        const inn = panels[i];
        out.classList.remove('is-active');
        inn.classList.add('is-active');
        gsap.killTweensOf([out, inn, ...titleChars[i]]);
        gsap.to(out, { autoAlpha: 0, y: -14, duration: 0.25, ease: 'power2.in' });
        gsap.fromTo(inn, { autoAlpha: 0, y: 20 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'expo.out', delay: 0.08 });
        gsap.fromTo(titleChars[i], { yPercent: 110, rotationX: -80 }, { yPercent: 0, rotationX: 0, duration: 0.7, ease: 'expo.out', stagger: 0.018, delay: 0.1 });
      };

      cards.forEach((c, i) => c.classList.toggle('is-front', i === 0));
      panels.forEach((p, i) => gsap.set(p, { autoAlpha: i === 0 ? 1 : 0, y: 0 }));
      render();

      const tween = gsap.to(state, {
        a: -(N - 1) * STEP,
        ease: 'none',
        onUpdate: render,
        scrollTrigger: {
          trigger: pin,
          pin: true,
          start: `top top+=${navH}`,
          end: () => `+=${(N - 1) * innerHeight * 0.75}`,
          scrub: 0.7,
          snap: { snapTo: 1 / (N - 1), inertia: false, duration: { min: 0.25, max: 0.7 }, ease: 'power2.inOut', delay: 0.08 },
          invalidateOnRefresh: true,
        },
      });
      const st = tween.scrollTrigger!;

      const goTo = (i: number) => {
        const k = Math.max(0, Math.min(N - 1, i));
        const y = st.start + (k / (N - 1)) * (st.end - st.start) + 1;
        gsap.to(scroller, { scrollTo: { y, autoKill: true }, duration: 0.9, ease: 'power3.inOut' });
      };

      // Cards: the front one opens, a side one turns to the front.
      const onCard = (e: MouseEvent) => {
        const i = Number((e.currentTarget as HTMLElement).dataset.i);
        if (dragged) return e.preventDefault();
        if (i !== active) {
          e.preventDefault();
          goTo(i);
        }
      };
      const onFocus = (e: FocusEvent) => goTo(Number((e.currentTarget as HTMLElement).dataset.i));
      cards.forEach((c) => {
        c.addEventListener('click', onCard);
        c.addEventListener('focus', onFocus);
      });
      const navBtns = [...sec.querySelectorAll<HTMLButtonElement>('.ring-nav button')];
      const onNav = (e: Event) => goTo(active + Number((e.currentTarget as HTMLElement).dataset.step));
      navBtns.forEach((b) => b.addEventListener('click', onNav));

      // Drag to turn: maps horizontal drag onto the pinned scroll distance.
      let dragged = false;
      let drag: { x: number; y: number } | null = null;
      const perCard = () => (st.end - st.start) / (N - 1);
      const scrollY = () => (scroller === window ? window.scrollY : (scroller as HTMLElement).scrollTop);
      const onDown = (e: PointerEvent) => {
        if (e.button !== 0) return;
        drag = { x: e.clientX, y: scrollY() };
        dragged = false;
      };
      const onMove = (e: PointerEvent) => {
        if (!drag) return;
        const dx = e.clientX - drag.x;
        if (Math.abs(dx) > 6) dragged = true;
        if (!dragged) return;
        const y = drag.y - (dx / W) * perCard() * 1.2;
        if (scroller === window) window.scrollTo(0, y);
        else (scroller as HTMLElement).scrollTop = y;
      };
      const onUp = () => {
        drag = null;
        setTimeout(() => (dragged = false), 0);
      };
      sceneEl.addEventListener('pointerdown', onDown);
      addEventListener('pointermove', onMove);
      addEventListener('pointerup', onUp);
      sceneEl.addEventListener('dragstart', (e) => e.preventDefault());

      // Pointer parallax: the whole ring leans toward the cursor.
      let onLean: ((e: PointerEvent) => void) | null = null;
      if (finePointer()) {
        const rx = gsap.quickTo(tilt, 'rotationX', { duration: 0.9, ease: 'power3.out' });
        const ry = gsap.quickTo(tilt, 'rotationY', { duration: 0.9, ease: 'power3.out' });
        onLean = (e: PointerEvent) => {
          rx(((e.clientY / innerHeight) - 0.5) * -10);
          ry(((e.clientX / innerWidth) - 0.5) * 12);
        };
        pin.addEventListener('pointermove', onLean);
      }

      return () => {
        cards.forEach((c) => {
          c.removeEventListener('click', onCard);
          c.removeEventListener('focus', onFocus);
          c.style.transform = '';
          c.style.pointerEvents = '';
        });
        navBtns.forEach((b) => b.removeEventListener('click', onNav));
        sceneEl.removeEventListener('pointerdown', onDown);
        removeEventListener('pointermove', onMove);
        removeEventListener('pointerup', onUp);
        if (onLean) pin.removeEventListener('pointermove', onLean);
        ring.style.transform = '';
        root.classList.remove('ring-on');
      };
    });

    // Fallback carousel: cards lean away from the centre as they scroll past (coverflow lite).
    const track = sec.querySelector<HTMLElement>('.rl-track');
    const items = [...sec.querySelectorAll<HTMLElement>('.rl-card')];
    if (track && motionOK()) {
      let raf = 0;
      const lean = () => {
        const mid = track.getBoundingClientRect().left + track.clientWidth / 2;
        items.forEach((it) => {
          const r = it.getBoundingClientRect();
          const d = Math.max(-1.5, Math.min(1.5, (r.left + r.width / 2 - mid) / r.width));
          it.style.transform = `perspective(900px) rotateY(${d * -18}deg) scale(${1 - Math.abs(d) * 0.06})`;
          it.style.opacity = String(1 - Math.abs(d) * 0.25);
        });
      };
      track.addEventListener('scroll', () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(lean);
      }, { passive: true });
      addEventListener('resize', lean);
      lean();
    }
  }
</script>

<style>
  /* ---------- 3D ring (desktop, motion) ---------- */
  .ring-pin {
    display: none;
  }

  :global(html.ring-on) .ring-pin {
    position: relative;
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--nav-h));
    overflow: hidden;
    --card: clamp(220px, min(24vw, 40svh), 420px);
  }

  :global(html.ring-on) .rl {
    display: none;
  }

  .ring-head {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    padding-top: 28px;
  }

  .ring-count {
    font-size: 0.875rem;
    color: var(--ink);
  }

  .ring-cur {
    color: var(--accent);
  }

  .ring-ghost {
    position: absolute;
    left: 0;
    top: 50%;
    margin-top: -0.55em;
    z-index: 0;
    white-space: nowrap;
    font-size: clamp(8rem, 19vw, 22rem);
    font-stretch: 62%;
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgb(240 237 231 / 0.08);
    pointer-events: none;
    padding-left: var(--gut);
    will-change: transform;
  }

  /* A perspective grid floor that scrolls with the ring. */
  .ring-floor {
    position: absolute;
    left: -25%;
    right: -25%;
    bottom: -10%;
    height: 62%;
    z-index: 0;
    background-image:
      linear-gradient(rgb(245 165 36 / 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgb(245 165 36 / 0.16) 1px, transparent 1px);
    background-size: 64px 64px;
    transform: perspective(600px) rotateX(72deg);
    transform-origin: 50% 100%;
    -webkit-mask-image: radial-gradient(ellipse 50% 70% at 50% 100%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse 50% 70% at 50% 100%, #000 10%, transparent 70%);
    pointer-events: none;
  }

  .ring-scene {
    position: relative;
    z-index: 2;
    flex: 1;
    display: grid;
    place-items: center;
    perspective: 1800px;
    perspective-origin: 50% 40%;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }

  .ring-scene:active {
    cursor: grabbing;
  }

  .ring-tilt,
  .ring {
    transform-style: preserve-3d;
  }

  .ring {
    position: relative;
    width: var(--card);
    aspect-ratio: 1;
  }

  .ring-card {
    position: absolute;
    inset: 0;
    display: block;
    backface-visibility: hidden;
    -webkit-box-reflect: below 14px linear-gradient(transparent 78%, rgb(0 0 0 / 0.16));
    -webkit-user-drag: none;
  }

  .ring-card :global(.cover) {
    width: 100%;
    height: 100%;
  }

  .ring-card :global(img) {
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .ring-card.is-front {
    box-shadow:
      0 0 0 1px rgb(245 165 36 / 0.6),
      0 30px 80px -20px rgb(245 165 36 / 0.35);
  }

  .ring-card.is-front.corners::after {
    --c: var(--accent);
    inset: -10px;
  }

  .ring-shade {
    position: absolute;
    inset: 0;
    background: #050506;
    pointer-events: none;
  }

  .ring-num {
    position: absolute;
    top: 10px;
    left: 12px;
    z-index: 2;
    color: var(--ink);
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.8);
  }

  .ring-foot {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding-bottom: 36px;
  }

  .ring-info {
    display: grid;
    flex: 1;
    max-width: 640px;
  }

  .ri {
    grid-area: 1 / 1;
    visibility: hidden;
  }

  .ri.is-active {
    visibility: visible;
  }

  .ri-title {
    font-size: clamp(2.4rem, 1.2rem + 3vw, 4.4rem);
    margin: 10px 0 12px;
    perspective: 600px;
  }

  .ri-pitch {
    color: var(--ink-2);
    max-width: 52ch;
    margin-bottom: 14px;
  }

  .ri-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ring-ctrl {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ring-nav {
    display: flex;
    gap: 8px;
  }

  .ring-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--line);
    z-index: 3;
  }

  .ring-progress i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  /* ---------- Swipe carousel (phones, reduced motion, no JS) ---------- */
  .rl {
    padding-top: var(--sec);
  }

  .rl-head {
    display: grid;
    gap: 16px;
    margin-bottom: 32px;
  }

  .rl-head h2 {
    font-size: var(--t-h2);
  }

  .rl-track {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 8px var(--gut) 24px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gut);
    scrollbar-width: none;
  }

  .rl-track::-webkit-scrollbar {
    display: none;
  }

  .rl-item {
    flex: 0 0 min(80vw, 420px);
    scroll-snap-align: center;
  }

  .rl-card {
    display: block;
    height: 100%;
    color: var(--ink);
    text-decoration: none;
    background: var(--ground-alt);
    border: 1px solid var(--line);
    transition: border-color 0.2s;
  }

  .rl-card:hover {
    border-color: var(--line-strong);
  }

  .rl-media {
    aspect-ratio: 1;
  }

  .rl-media :global(.cover) {
    height: 100%;
  }

  .rl-body {
    padding: 18px 18px 22px;
  }

  .rl-body h3 {
    font-size: 2.1rem;
    margin: 8px 0 10px;
  }
</style>
