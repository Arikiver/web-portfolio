---
// Every project at a glance, with key art. Discipline filters reflow the grid with GSAP Flip:
// cards that stay glide to their new slots, the rest scale away.
import Cover from './Cover.astro';
import { disciplineLabel, type Discipline, type Project } from '../data/portfolio';
import { url } from '../lib/url';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const year = (p: Project) => p.meta.find((m) => m.label === 'Dates' || m.label === 'Released')?.value ?? '';
const filters: { id: 'all' | Discipline; label: string; n: number }[] = [
  { id: 'all', label: 'All', n: projects.length },
  ...(Object.keys(disciplineLabel) as Discipline[]).map((d) => ({
    id: d,
    label: disciplineLabel[d],
    n: projects.filter((p) => p.disciplines.includes(d)).length,
  })),
];
---

<section id="archive" class="section">
  <div class="wrap">
    <header class="sec-head" data-reveal-group>
      <p class="hud" data-reveal><span class="num">02</span>Archive</p>
      <h2 data-reveal="lines">Every project</h2>
      <div class="filters" role="group" aria-label="Filter projects by discipline" data-reveal>
        {
          filters.map((f, i) => (
            <button type="button" class="filter" data-f={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label}
              <span class="filter-n">{pad(f.n)}</span>
            </button>
          ))
        }
      </div>
    </header>

    <ul class="pgrid">
      {
        projects.map((p, i) => (
          <li class="pcard-wrap" data-disc={p.disciplines.join(' ')} data-reveal-group>
            <div data-reveal="pop">
              <a class="pcard corners" href={url(`/work/${p.slug}/`)} data-tilt="7" data-cursor="Open">
                <div class="pcard-media frame">
                  <Cover file={p.cover} alt={`${p.title} cover art`} sizes="(min-width: 1100px) 400px, (min-width: 640px) 45vw, 30vw" widths={[300, 500, 800]} position={p.coverPosition} vt={`cover-${p.slug}`} />
                </div>
                <span class="glare" aria-hidden="true" />
                <div class="pcard-body">
                  <p class="hud">
                    <span class="num">{pad(i + 1)}</span>
                    {year(p)}
                  </p>
                  <h3 style={`view-transition-name: title-${p.slug}`}>{p.title}</h3>
                  <p class="pcard-pitch">{p.pitch}</p>
                  <ul class="pcard-tags">
                    {p.disciplines.map((d) => (
                      <li class="hud-tag">{disciplineLabel[d]}</li>
                    ))}
                  </ul>
                </div>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { Flip } from 'gsap/Flip';
  import { motionOK } from '../scripts/scene';

  gsap.registerPlugin(Flip);

  const grid = document.querySelector<HTMLElement>('.pgrid');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#archive .filter')];
  const items = [...document.querySelectorAll<HTMLElement>('.pcard-wrap')];

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.f!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      const state = Flip.getState(items);
      items.forEach((it) => {
        it.hidden = !(f === 'all' || it.dataset.disc!.split(' ').includes(f));
        it.querySelector<HTMLElement>('[data-reveal]')?.classList.add('is-in');
      });
      if (!motionOK() || !grid) return;
      Flip.from(state, {
        duration: 0.7,
        ease: 'expo.inOut',
        absolute: true,
        stagger: 0.03,
        onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: 0.85, rotationX: -25 }, { opacity: 1, scale: 1, rotationX: 0, duration: 0.6, ease: 'expo.out', delay: 0.25 }),
        onLeave: (els) => gsap.to(els, { opacity: 0, scale: 0.85, duration: 0.35, ease: 'power2.in' }),
      });
    }),
  );
</script>

<style>
  .pgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    perspective: 1400px;
  }

  .pgrid > li[hidden] {
    display: none;
  }

  .pcard-wrap > div {
    height: 100%;
  }

  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--ground-alt);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.5s var(--ease),
      border-color 0.3s,
      box-shadow 0.4s;
  }

  .pcard:hover,
  .pcard:focus-visible {
    border-color: rgb(245 165 36 / 0.45);
    box-shadow: 0 30px 70px -30px rgb(245 165 36 / 0.35);
  }

  .pcard:hover.corners::after {
    --c: var(--accent);
    inset: -8px;
  }

  .pcard-media {
    aspect-ratio: 4 / 3;
  }

  .pcard-media :global(.cover) {
    height: 100%;
    aspect-ratio: auto;
  }

  .pcard-media :global(img) {
    transition: scale 0.8s var(--ease);
  }

  .pcard:hover .pcard-media :global(img) {
    scale: 1.07;
  }

  .pcard-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px 20px 20px;
    transform: translateZ(30px);
  }

  .pcard h3 {
    font-size: 2rem;
    margin: 10px 0 10px;
  }

  .pcard-pitch {
    flex: 1;
    color: var(--ink-2);
    font-size: var(--t-small);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .pcard-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phones: compact rows, art on the left. */
  @media (max-width: 559px) {
    .pgrid {
      gap: 12px;
    }

    .pcard {
      display: grid;
      grid-template-columns: 112px 1fr;
    }

    .pcard-media {
      aspect-ratio: auto;
      min-height: 100%;
    }

    .pcard-body {
      padding: 12px 14px;
    }

    .pcard h3 {
      font-size: 1.45rem;
      margin: 6px 0;
    }

    .pcard-pitch {
      font-size: 0.875rem;
      margin-bottom: 10px;
    }

    .pcard-tags {
      display: none;
    }
  }
</style>
