---
import { Image, getImage } from 'astro:assets';
import { image } from '../lib/images';

interface Props {
  items: { file: string; alt: string }[];
}

const { items } = Astro.props;
const shots = await Promise.all(
  items.map(async (item) => {
    const src = await image(item.file);
    const full = await getImage({ src, width: Math.min(src.width, 1600), format: 'webp' });
    return { ...item, src, full: full.src };
  }),
);
---

<ul class="gallery">
  {
    shots.map((shot, i) => (
      <li>
        <button type="button" class="thumb" data-full={shot.full} data-alt={shot.alt} data-index={i} aria-label={`Enlarge: ${shot.alt}`}>
          <Image
            src={shot.src}
            alt={shot.alt}
            widths={[400, 700].filter((w) => w <= shot.src.width)}
            sizes="(min-width: 1184px) 368px, (min-width: 720px) calc(33vw - 32px), calc(100vw - 32px)"
            format="webp"
            loading="lazy"
          />
        </button>
      </li>
    ))
  }
</ul>

<dialog class="lightbox" aria-label="Screenshot viewer">
  <img src="" alt="" />
  <div class="controls">
    <button type="button" class="btn" data-step="-1" aria-label="Previous screenshot">←</button>
    <span class="count" aria-live="polite"></span>
    <button type="button" class="btn" data-step="1" aria-label="Next screenshot">→</button>
    <button type="button" class="btn close" aria-label="Close">Close ✕</button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.gallery .thumb')];
  if (dialog && thumbs.length) {
    const img = dialog.querySelector('img')!;
    const count = dialog.querySelector('.count')!;
    let current = 0;
    const show = (i: number) => {
      current = (i + thumbs.length) % thumbs.length;
      const next = thumbs[current];
      img.classList.add('is-loading');
      img.onload = () => img.classList.remove('is-loading');
      img.src = next.dataset.full!;
      img.alt = next.dataset.alt!;
      if (img.complete) img.classList.remove('is-loading');
      count.textContent = `${current + 1} / ${thumbs.length}`;
    };
    thumbs.forEach((t, i) =>
      t.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => show(current + Number(b.dataset.step))),
    );
    dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
    // Click on the backdrop closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('close', () => thumbs[current].focus());
  }
</script>

<style>
  .gallery {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 0.75rem;
  }

  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface-2);
    cursor: zoom-in;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .thumb:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .thumb img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s ease;
    filter: saturate(0.85) brightness(0.9);
  }

  .thumb:hover img,
  .thumb:focus-visible img {
    transform: scale(1.06);
    filter: none;
  }

  .lightbox {
    width: min(1400px, calc(100vw - 2 * var(--gutter)));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
    opacity: 0;
    scale: 0.94;
    transition:
      opacity 0.3s ease,
      scale 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      overlay 0.4s allow-discrete,
      display 0.4s allow-discrete;
  }

  .lightbox[open] {
    opacity: 1;
    scale: 1;
  }

  @starting-style {
    .lightbox[open] {
      opacity: 0;
      scale: 0.94;
    }
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0);
    backdrop-filter: blur(0);
    transition:
      background-color 0.3s ease,
      backdrop-filter 0.3s ease,
      overlay 0.4s allow-discrete,
      display 0.4s allow-discrete;
  }

  .lightbox[open]::backdrop {
    background: rgb(0 0 0 / 0.85);
    backdrop-filter: blur(6px);
  }

  @starting-style {
    .lightbox[open]::backdrop {
      background: rgb(0 0 0 / 0);
      backdrop-filter: blur(0);
    }
  }

  .lightbox img {
    width: 100%;
    max-height: calc(100dvh - 7rem);
    object-fit: contain;
    background: #000;
    transition: opacity 0.25s ease;
  }

  .lightbox img.is-loading {
    opacity: 0;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    padding-inline: 0.5rem;
  }

  .close {
    margin-left: auto;
  }
</style>
