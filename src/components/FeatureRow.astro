---
import Cover from './Cover.astro';
import { disciplineLabel, type Project } from '../data/portfolio';
import { url } from '../lib/url';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const meta = (...labels: string[]) => labels.map((l) => project.meta.find((m) => m.label === l)?.value).find(Boolean);
const facts = [
  { label: 'Year', value: meta('Dates', 'Released') },
  { label: 'Engine', value: meta('Engine') ?? project.stack[0] },
  { label: 'Role', value: meta('Role') ?? meta('Type') },
].filter((f) => f.value);
const href = url(`/work/${project.slug}/`);
---

<article class="feature grid" data-reveal-row>
  <div class="feature-text">
    <p class="label" data-reveal>
      <span class="num">{String(index).padStart(2, '0')}</span>{project.disciplines.map((d) => disciplineLabel[d]).join(' · ')}
    </p>
    <h3 data-reveal="lines">
      <a class="stretched" href={href} style={`view-transition-name: title-${project.slug}`}>{project.title}</a>
    </h3>
    <p class="feature-pitch" data-reveal>{project.pitch}</p>
    <dl class="feature-facts" data-reveal>
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
    <span class="feature-cta link-arrow" data-reveal aria-hidden="true">View project</span>
  </div>
  <div class="feature-media frame" data-reveal="media">
    <Cover
      file={project.cover}
      alt={`${project.title} cover art`}
      sizes="(min-width: 1360px) 520px, (min-width: 900px) 38vw, calc(100vw - 48px)"
      widths={[400, 640, 900, 1100]}
      vt={`cover-${project.slug}`}
    />
  </div>
</article>

<style>
  .feature {
    position: relative;
    border-top: 1px solid var(--line);
    padding-block: 32px 48px;
    row-gap: 24px;
  }

  .feature-text,
  .feature-media {
    grid-column: 1 / -1;
  }

  .feature-media {
    order: -1;
  }

  @media (min-width: 900px) {
    .feature {
      padding-block: 40px 56px;
    }

    .feature-text {
      grid-column: 1 / 7;
      display: flex;
      flex-direction: column;
    }

    .feature-media {
      order: 0;
      grid-column: 8 / 13;
    }
  }

  .feature h3 {
    margin: 16px 0 16px;
    font-size: var(--t-h3);
  }

  .feature h3 a {
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0% 1px;
    transition: background-size var(--hover-out) var(--ease);
  }

  .feature:hover h3 a,
  .feature h3 a:focus-visible {
    background-size: 100% 1px;
    transition-duration: var(--hover-in);
  }

  /* The title link covers the whole row. */
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .stretched:focus-visible {
    outline: none;
  }

  .feature:has(.stretched:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  .feature-pitch {
    max-width: 38ch;
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--ink-2);
    margin-bottom: 32px;
  }

  .feature-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 16px 24px;
    margin: 0 0 32px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    max-width: 34rem;
  }

  .feature-facts dt {
    font-size: var(--t-label);
    font-weight: 500;
    color: var(--ink-3);
  }

  .feature-facts dd {
    margin: 2px 0 0;
    font-size: var(--t-small);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 900px) {
    .feature-cta {
      margin-top: auto;
    }
  }

  .feature-cta {
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink);
  }

  .feature:hover .feature-cta::after {
    translate: 3px 0;
    transition-duration: var(--hover-in);
  }

  .feature-media :global(img) {
    transition: scale 0.6s var(--ease);
  }

  .feature:hover .feature-media :global(img) {
    scale: 1.03;
  }
</style>
