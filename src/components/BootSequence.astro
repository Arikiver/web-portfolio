---
// First-visit boot screen (once per browser session). Browsers lock audio until a gesture, so unless
// audio is already allowed it opens on a "press any key" screen; that press unlocks the boot
// soundtrack. Each log line then reports something real (WebGL, shader compile, fonts,
// above-the-fold images), so the progress bar tracks actual loading: minimum ~1.6 s, capped at
// ~4 s. Any key/click/tap skips. Shown only when html.booting was set before first paint by the
// inline script in Base.astro: never with reduced motion, never without JS.
import { profile } from '../data/portfolio';
---

<div class="boot" aria-hidden="true">
  <div class="boot-inner">
    <p class="boot-title"><span class="boot-mark"></span>{profile.name.toUpperCase().replace(' ', '.')}</p>
    <p class="boot-sub">RT_BIOS 26.09 · real-time portfolio</p>
    <p class="boot-gate">
      <span class="gate-keys">▸ PRESS ANY KEY TO START</span>
      <span class="gate-touch">▸ TAP TO START</span>
      <span class="gate-note">sound on</span>
    </p>
    <ol class="boot-log"></ol>
    <div class="boot-bar"><i></i></div>
    <p class="boot-foot"><span class="boot-pct">0%</span><span class="boot-skip">press any key to skip</span></p>
  </div>
</div>

<script>
  import { play, running, startCharge, unlockAudio } from '../scripts/sfx';

  const root = document.documentElement;
  const boot = document.querySelector<HTMLElement>('.boot');

  if (boot && root.classList.contains('booting')) {
    root.classList.add('boot-alive'); // tells the fail-safe in Base.astro we're in control
    const log = boot.querySelector('.boot-log')!;
    const bar = boot.querySelector<HTMLElement>('.boot-bar i')!;
    const pct = boot.querySelector('.boot-pct')!;
    const MIN = 1600;
    const MAX = 4000;
    let start = 0;
    let finished = false;
    let charge = { set: (_p: number) => {}, stop: () => {} };

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const until = (test: () => boolean, timeout: number) =>
      new Promise<boolean>((resolve) => {
        const t0 = performance.now();
        const tick = () => (test() ? resolve(true) : performance.now() - t0 > timeout ? resolve(false) : requestAnimationFrame(tick));
        tick();
      });

    const line = (label: string) => {
      const li = document.createElement('li');
      li.innerHTML = `<span class="p">&gt;</span> <span class="l"></span><span class="d"></span><span class="s"></span>`;
      li.querySelector('.l')!.textContent = label;
      log.append(li);
      // Key clicks as the label "types" in.
      for (let i = 0; i < Math.ceil(label.length / 3); i++) setTimeout(() => play('typeTick'), i * 24);
      const s = li.querySelector('.s')!;
      const done = (status: string, tone: 'ok' | 'warn' = 'ok') => {
        s.textContent = status;
        li.classList.add('done', tone);
        play(tone === 'ok' ? 'bootOk' : 'bootWarn');
      };
      return Object.assign(done, { set: (text: string) => (s.textContent = text) });
    };

    // Real work, reported as it completes.
    let tasksDone = 0;
    const TASKS = 5;
    const step = () => tasksDone++;

    const images = [...document.images].filter((img) => {
      const r = img.getBoundingClientRect();
      return r.top < innerHeight && r.bottom > 0 && img.loading !== 'lazy';
    });

    const run = async () => {
      const gpu = line('probing gpu');
      await wait(260);
      const gl = document.createElement('canvas').getContext('webgl');
      gpu(gl ? 'WEBGL OK' : 'SOFTWARE', gl ? 'ok' : 'warn');
      step();

      const sh = line('compiling shaders');
      const shader = document.querySelector('canvas.hero-fx, canvas.ambient-field');
      const [ok] = await Promise.all([until(() => !!document.querySelector('canvas.is-live'), 1500), wait(300)]);
      sh(shader ? (ok ? 'OK' : 'SKIPPED') : 'OK', ok || !shader ? 'ok' : 'warn');
      step();

      const fonts = line('loading fonts');
      await Promise.all([Promise.race([document.fonts.ready, wait(1500)]), wait(280)]);
      fonts('OK');
      step();

      const assets = line('streaming assets');
      const assetsStart = performance.now();
      let loaded = 0;
      const total = images.length;
      const render = () => assets.set(`${loaded}/${total}`);
      render();
      await Promise.race([
        Promise.all(
          images.map((img) =>
            (img.complete ? Promise.resolve() : img.decode().catch(() => {})).then(() => {
              loaded++;
              render();
              play('bootCount', loaded);
            }),
          ),
        ),
        wait(2500),
      ]);
      await wait(Math.max(0, 300 - (performance.now() - assetsStart)));
      assets(`${loaded}/${total}`, loaded === total ? 'ok' : 'warn');
      step();

      const audio = line('audio');
      await wait(200);
      audio(running() ? 'ONLINE' : 'MUTED', running() ? 'ok' : 'warn');
      step();
    };

    // Progress = the slower of real work and the minimum runtime, so it never finishes early.
    const progress = () => Math.min(Math.min(1, (performance.now() - start) / MIN), tasksDone / TASKS);

    const frame = () => {
      if (finished) return;
      const p = progress();
      bar.style.transform = `scaleX(${p})`;
      pct.textContent = `${Math.round(p * 100)}%`;
      charge.set(p);
      if ((p >= 1 && tasksDone >= TASKS) || performance.now() - start > MAX) finish();
      else requestAnimationFrame(frame);
    };

    const finish = () => {
      if (finished) return;
      finished = true;
      charge.stop();
      bar.style.transform = 'scaleX(1)';
      pct.textContent = '100%';
      const ready = document.createElement('li');
      ready.className = 'ready';
      ready.textContent = 'READY';
      log.append(ready);
      play('bootReady');
      try {
        sessionStorage.setItem('booted', '1');
      } catch {
        /* ignore */
      }
      setTimeout(() => {
        boot.classList.add('boot-exit');
        play('bootOpen');
        // Release the page (hero entrance, decode, etc.) as the screen opens.
        setTimeout(() => {
          root.classList.remove('booting');
          document.dispatchEvent(new Event('boot:done'));
        }, 180);
        setTimeout(() => boot.remove(), 700);
      }, 260);
    };

    const skip = () => finish();

    // Power on: the log starts, sounds and all.
    let begun = false;
    const begin = async () => {
      if (begun) return;
      begun = true;
      GATE_EVENTS.forEach((t) => removeEventListener(t, onGate, true));
      await unlockAudio(); // no-op if already running; inside a gesture this is what unlocks audio
      boot.classList.add('is-running');
      play('bootPress');
      await wait(180);
      play('bootTitle');
      start = performance.now();
      charge = startCharge();
      void run();
      requestAnimationFrame(frame);
      // Arm skipping a beat later, so the key that started the boot doesn't also skip it.
      setTimeout(() => {
        addEventListener('keydown', skip, { once: true });
        boot.addEventListener('pointerdown', skip, { once: true });
      }, 350);
    };

    // Browsers keep audio locked until a gesture, so ask for one ("press start") unless audio is
    // already allowed. Scrolling also starts it (silently) so nobody gets stuck.
    const GATE_EVENTS = ['keydown', 'pointerdown', 'wheel', 'touchmove'];
    const onGate = () => void begin();
    void unlockAudio().then((ok) => {
      if (ok) return void begin();
      boot.classList.add('is-gated');
      GATE_EVENTS.forEach((t) => addEventListener(t, onGate, { capture: true, passive: true }));
    });
  } else {
    boot?.remove();
  }
</script>

<style>
  .boot {
    display: none;
  }

  :global(.booting) .boot,
  .boot.boot-exit {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background:
      repeating-linear-gradient(to bottom, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px),
      radial-gradient(ellipse at center, #111118, #050507 75%);
    color: var(--muted);
    font: 0.82rem/1.7 var(--font-mono);
    cursor: default;
  }

  /* While booting, hold the hero entrance so it plays after the screen opens. */
  :global(.booting) :global(:is(.letter, .hero-in, .caret)) {
    animation-play-state: paused !important;
  }

  :global(html.booting),
  :global(html.booting body) {
    overflow: hidden;
  }

  .boot-inner {
    width: min(100%, 520px);
    min-width: 0;
  }

  /* Until started, only the title and the "press start" prompt show. */
  .boot:not(.is-running) :is(.boot-log, .boot-bar, .boot-foot) {
    visibility: hidden;
  }

  .boot-gate {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    margin: 2.5rem 0 0;
    text-align: center;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  .boot.is-gated:not(.is-running) .boot-gate {
    display: block;
  }

  .boot-gate > span {
    display: block;
  }

  .gate-keys,
  .gate-touch {
    animation: boot-blink 1.1s steps(2, jump-none) infinite;
    text-shadow: 0 0 12px rgb(245 165 36 / 0.6);
  }

  .gate-touch {
    display: none !important;
  }

  @media (hover: none) {
    .gate-keys {
      display: none !important;
    }

    .gate-touch {
      display: block !important;
    }
  }

  .gate-note {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    opacity: 0.6;
  }

  .boot.is-gated {
    cursor: pointer;
  }

  .boot-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--text);
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .boot-mark {
    width: 9px;
    height: 9px;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
    animation: boot-blink 0.8s steps(2, jump-none) infinite;
  }

  .boot-sub {
    margin: 0 0 1.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    opacity: 0.6;
  }

  .boot-log {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    min-height: calc(6 * 1.7em);
  }

  .boot-log :global(li) {
    display: flex;
    min-width: 0;
    white-space: nowrap;
    animation: boot-line 0.18s steps(3) both;
  }

  .boot-log :global(.p) {
    color: var(--accent);
    margin-right: 0.5ch;
  }

  /* Dot leader fills the gap between label and status. */
  .boot-log :global(.d) {
    flex: 1 1 0;
    min-width: 2ch;
    margin: 0 1ch;
    overflow: hidden;
    opacity: 0.35;
  }

  .boot-log :global(.d)::before {
    content: '................................................................';
  }

  .boot-log :global(li:not(.done) .s)::after {
    content: '▍';
    animation: boot-blink 0.5s steps(2, jump-none) infinite;
  }

  .boot-log :global(li.done.ok .s) {
    color: var(--accent);
  }

  .boot-log :global(li.done.warn .s) {
    color: #ff8a5c;
  }

  .boot-log :global(li.ready) {
    color: var(--text);
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .boot-log :global(li.ready)::after {
    content: '_';
    color: var(--accent);
    animation: boot-blink 0.5s steps(2, jump-none) infinite;
  }

  .boot-bar {
    height: 6px;
    border: 1px solid var(--border);
    padding: 1px;
  }

  .boot-bar i {
    display: block;
    height: 100%;
    background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 8px); /* segmented */
    box-shadow: 0 0 10px rgb(245 165 36 / 0.5);
    transform: scaleX(0);
    transform-origin: left;
  }

  .boot-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.6rem 0 0;
    font-size: 0.7rem;
  }

  .boot-pct {
    color: var(--text);
  }

  .boot-skip {
    opacity: 0.5;
  }

  /* Exit: the screen opens from a bright centre line, like a tube warming up. */
  .boot.boot-exit {
    animation: boot-open 0.5s cubic-bezier(0.7, 0, 0.3, 1) forwards;
    pointer-events: none;
  }

  .boot.boot-exit::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    background: #fff;
    box-shadow:
      0 0 20px 4px var(--accent),
      0 0 60px 10px rgb(245 165 36 / 0.5);
    animation: boot-line-flash 0.5s ease-out forwards;
  }

  @keyframes boot-open {
    0% {
      clip-path: inset(0 0 0 0);
    }
    30% {
      clip-path: inset(0 0 0 0);
      filter: brightness(1.6);
    }
    100% {
      clip-path: inset(50% 0 50% 0);
    }
  }

  @keyframes boot-line-flash {
    0%,
    30% {
      opacity: 0;
    }
    45% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: scaleX(1.2);
    }
  }

  @keyframes boot-line {
    from {
      opacity: 0;
    }
  }

  @keyframes boot-blink {
    50% {
      opacity: 0;
    }
  }
</style>
